# Copy to .env and adjust. The app reads these at startup.

# Redis connection (managed endpoint, or redis://127.0.0.1:6379/0 for local).
STOCKLAB_REDIS_URL=redis://default:password@host:port/0

# Reproducibility: global seed for NumPy / PyTorch / optimizers.
STOCKLAB_SEED=1337

# Worker pool size (concurrent benchmark jobs). Keep small on a 6-core CPU.
STOCKLAB_MAX_WORKERS=2

# Threads per heavy library (PyTorch / sklearn) to avoid oversubscription.
STOCKLAB_TORCH_THREADS=4

# Cache / job TTLs in seconds.
STOCKLAB_CACHE_TTL=21600
STOCKLAB_JOB_TTL=86400
